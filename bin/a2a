#!/usr/bin/env python3
"""a2a — 跨 Agent 消息 CLI (NATS JetStream 总线)

用法:
  a2a inbox [--unread] [--since N] [--limit N] [--thread ID] [--group] [--json]
  a2a send <to> <subject> <body>   # to 支持逗号分隔多收件人, 如 "hermes,see"
  a2a reply <id> <body>
  a2a mark-read <id>
  a2a status <id> <status>
  a2a watch [--json]            # SSE 实时监听新消息
  a2a meet <topic> [--tail N] [--leave]  # 房间交互开会 (实时收发, /leave 或 Ctrl-C 退出)
  a2a ask <to> <问题...> [--timeout N]  # 提问挂起等回复 (reply_to 匹配), 默认超时 600s
  a2a contacts
  a2a presence               # 各 agent 在线状态
  a2a health

配置 (环境变量):
  A2A_URL   默认 http://100.68.80.91:3010
  A2A_TOKEN 本 agent 的 Bearer token (必填, 或用 --agent 从 tokens.env 读取)
  --agent <slug> 从 tokens.env 自动取 token (本机开发用)

纯 stdlib, 任何机器 python3 直接跑。
"""
import argparse
import json
import os
import re
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid

DEFAULT_URL = os.environ.get("A2A_URL", "http://100.68.80.91:3010")
TOKENS_FILE = os.path.expanduser("~/projects/a2a-bus/tokens.env")


def load_tokens():
    tok = {}
    try:
        for line in open(TOKENS_FILE):
            if line.startswith("A2A_TOKENS="):
                for p in line.split("=", 1)[1].split(","):
                    a, t = p.strip().split(":", 1)
                    tok[a] = t
    except OSError:
        pass
    return tok


def resolve_token(args) -> tuple[str, str]:
    """返回 (base_url, token)。--agent 优先, 其次 A2A_TOKEN env。"""
    tok = None
    if args.agent:
        tok = load_tokens().get(args.agent)
        if not tok:
            sys.exit(f"ERROR: 未在 tokens.env 找到 agent {args.agent!r}")
    else:
        tok = os.environ.get("A2A_TOKEN")
        if not tok:
            sys.exit("ERROR: 需要 A2A_TOKEN 环境变量或 --agent <slug>")
    return args.url or DEFAULT_URL, tok


def req(base, path, token, method="GET", body=None, timeout=30):
    # 强制直连：绕过系统代理（腾讯云主机有 Mihomo 等代理时会劫持 Tailscale IP 请求 → 502）
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    r = urllib.request.Request(base + path, method=method)
    r.add_header("Authorization", f"Bearer {token}")
    r.add_header("User-Agent", "a2a-cli")
    if body is not None:
        r.add_header("Content-Type", "application/json")
        r.data = json.dumps(body, ensure_ascii=False).encode()
    try:
        with opener.open(r, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        try:
            err = json.loads(e.read().decode())
        except Exception:
            err = {"detail": str(e)}
        return e.code, err
    except (urllib.error.URLError, OSError, TimeoutError) as e:
        hint = "（无法连接 a2a 服务 — 检查 Tailscale 是否连通 (tailscale status)，或节点 a2a-api 是否在跑）"
        sys.exit(f"ERROR: 无法连接 {base} — {e} {hint}")


def fmt_msg(m) -> str:
    st = m["status"]
    flag = {"unread": "🆕", "read": "📖", "replied": "↩️", "archived": "🗄️", "recalled": "🚫"}.get(st, st)
    head = f"  #{m['id']} {flag} {m['from']} → {m['to']}  [{m['created']}] {m['subject']}"
    body = m.get("body") or ""
    lines = [head]
    if body:
        lines.append("      " + body.replace("\n", "\n      "))
    if m.get("reply_to"):
        lines.append(f"      (回复 #{m['reply_to']})")
    return "\n".join(lines)


def cmd_inbox(args, base, tok):
    path = f"/api/inbox/{args.agent}" if args.agent else "/api/inbox/me"
    params = []
    if args.unread:
        params.append("unread_only=true")
    if args.since is not None:
        params.append(f"since={args.since}")
    if args.limit:
        params.append(f"limit={args.limit}")
    if args.thread:
        params.append(f"thread={args.thread}")
    if params:
        path += "?" + "&".join(params)
    code, d = req(base, path, tok)
    if code != 200:
        sys.exit(f"ERROR {code}: {d}")
    if args.json:
        print(json.dumps(d, ensure_ascii=False, indent=2))
        return
    msgs = d["messages"]
    if args.group:
        # T9: 按 thread 分组显示
        groups = {}
        for m in msgs:
            groups.setdefault(m.get("thread") or "(无主题)", []).append(m)
        print(f"收件箱 {d['agent']}: {d['count']} 条, {len(groups)} 个会话")
        for g, gmsgs in groups.items():
            print(f"\n=== {g} ({len(gmsgs)} 条) ===")
            for m in gmsgs:
                print(fmt_msg(m))
                print()
    else:
        print(f"收件箱 {d['agent']}: {d['count']} 条")
        for m in msgs:
            print(fmt_msg(m))
            print()


def cmd_send(args, base, tok):
    body = args.body or ""
    targets = [t.strip() for t in args.to.split(",") if t.strip()]
    to = targets[0] if len(targets) == 1 else targets
    payload = {"to": to, "subject": args.subject, "body": body,
               "msg_id": str(uuid.uuid4())}  # 幂等键, 服务端 DuplicateWindow 内同 id 去重
    if args.reply_to:
        payload["reply_to"] = args.reply_to
    code, d = req(base, "/api/send", tok, "POST", payload)
    if code != 200:
        sys.exit(f"ERROR {code}: {d}")
    if isinstance(d.get("to"), list):
        n = len(d.get("seqs", [])) or len(d["to"])
        print(f"✅ 已发送 #{d['id']} → {n} 个收件人 {d['to']} [unread]")
    else:
        print(f"✅ 已发送 #{d['id']} → {d['to']} [{d['status']}]")


def cmd_reply(args, base, tok):
    # 自动继承原消息 thread (T9): 在收件箱里找原消息
    thread = None
    try:
        code0, d0 = req(base, "/api/inbox/me?limit=1000", tok)
        if code0 == 200:
            for m in d0.get("messages", []):
                if m["id"] == args.id:
                    thread = m.get("thread")
                    break
    except SystemExit:
        pass
    payload = {"to": args.to, "subject": args.subject, "body": args.body,
               "reply_to": args.id, "msg_id": str(uuid.uuid4())}
    if thread:
        payload["thread"] = thread
    code, d = req(base, "/api/send", tok, "POST", payload)
    if code != 200:
        sys.exit(f"ERROR {code}: {d}")
    code2, d2 = req(base, f"/api/status/{args.id}", tok, "POST", {"status": "replied"})
    if code2 != 200:
        sys.exit(f"ERROR 标原消息 replied 失败 {code2}: {d2}")
    print(f"✅ 已回复 #{args.id} (新消息 #{d['id']})，原消息已标 replied")


def cmd_status(args, base, tok):
    if args.status not in ("unread", "read", "replied", "archived", "recalled"):
        sys.exit(f"ERROR: 非法状态 {args.status}")
    code, d = req(base, f"/api/status/{args.id}", tok, "POST", {"status": args.status})
    if code != 200:
        sys.exit(f"ERROR {code}: {d}")
    print(f"✅ #{d['id']} → {d['status']}")


def cmd_watch(args, base, tok):
    import urllib.request as u
    opener = u.build_opener(u.ProxyHandler({}))  # 绕过系统代理，理由同 req()
    r = u.Request(base + "/api/events")
    r.add_header("Authorization", f"Bearer {tok}")
    try:
        resp = opener.open(r, timeout=None)
    except Exception as e:
        sys.exit(f"ERROR 连接 SSE: {e}")
    print("监听中... (Ctrl-C 退出)", file=sys.stderr)
    buf = b""
    try:
        while True:
            chunk = resp.read(1)
            if not chunk:
                break
            if chunk == b"\n":
                if buf.startswith(b"data: "):
                    item = json.loads(buf[6:].decode())
                    if args.json:
                        print(json.dumps(item, ensure_ascii=False))
                    else:
                        print(fmt_msg(item), flush=True)
                buf = b""
            else:
                buf += chunk
    except KeyboardInterrupt:
        pass


def _fmt_meet(m) -> str:
    """房间消息显示: [时间] from: body"""
    ts = (m.get("created") or "")[11:19]
    body = (m.get("body") or "").strip() or (m.get("subject") or "")
    return f"  [{ts}] {m['from']}: {body}"


def cmd_meet(args, base, tok):
    """进入房间交互 (T11): 轮询房间消息实时显示 + 输入发送; /leave 或 Ctrl-C 退出。
    房间无 SSE 端点, 用 1.5s 轮询 /api/inbox/room:<topic>?since= 实现实时显示。"""
    topic = args.topic
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,31}", topic):
        sys.exit(f"ERROR: 非法房间 topic: {topic!r}")
    room = f"room:{topic}"
    state = {"last_id": 0}
    # 加入时拉最近 N 条历史 (迟到补课)
    if args.tail:
        code, d = req(base, f"/api/inbox/{room}?limit={args.tail}", tok)
        if code == 200:
            for m in d["messages"]:
                print(_fmt_meet(m), flush=True)
                state["last_id"] = max(state["last_id"], m["id"])
            if d["messages"]:
                print(flush=True)
    if args.leave:  # --leave: 只拉历史/检查连接后退出 (非交互)
        return
    print(f"已加入房间 {room} (输入消息发送, /leave 或 Ctrl-C 退出)", file=sys.stderr)
    stop = threading.Event()

    def poll():
        while not stop.is_set():
            try:
                code, d = req(base, f"/api/inbox/{room}?since={state['last_id']}&limit=50", tok)
                if code == 200:
                    for m in d["messages"]:
                        print(_fmt_meet(m), flush=True)
                        state["last_id"] = max(state["last_id"], m["id"])
            except SystemExit:
                pass  # 连接失败不崩整个命令
            except Exception:
                pass
            time.sleep(1.5)

    threading.Thread(target=poll, daemon=True).start()
    try:
        for line in sys.stdin:
            line = line.strip()
            if not line:
                continue
            if line == "/leave":
                break
            code, d = req(base, "/api/send", tok, "POST",
                          {"to": room, "subject": "meet", "body": line,
                           "msg_id": str(uuid.uuid4())})
            if code != 200:
                print(f"ERROR {code}: {d}", file=sys.stderr)
    except KeyboardInterrupt:
        print()
    finally:
        stop.set()


def cmd_ask(args, base, tok):
    """ask <to> <问题> [--timeout N] (T12): 发消息并挂起等回复 (reply_to 匹配原消息),
    收到即打印返回; 超时提示退出。"""
    to = args.to
    question = " ".join(args.question)
    timeout = args.timeout or 600
    code, d = req(base, "/api/send", tok, "POST",
                  {"to": to, "subject": question[:80] or "ask", "body": question,
                   "msg_id": str(uuid.uuid4())})
    if code != 200:
        sys.exit(f"ERROR {code}: {d}")
    sent_id = d["id"]
    print(f"❓ 已问 #{sent_id} → {to}: {question}", file=sys.stderr)
    deadline = time.time() + timeout
    last = sent_id
    while time.time() < deadline:
        try:
            code, d = req(base, f"/api/inbox/me?since={last}&limit=50", tok)
            if code == 200:
                for m in d["messages"]:
                    last = max(last, m["id"])
                    if m.get("from") == to and m.get("reply_to") == sent_id:
                        reply = m.get("body") or m.get("subject") or ""
                        print(f"💬 {m['from']} 回复 #{m['id']}: {reply}")
                        return
        except SystemExit:
            pass
        except Exception:
            pass
        time.sleep(1.5)
    print(f"⏰ 等待 {timeout}s 未收到 {to} 的回复, 已超时退出", file=sys.stderr)
    sys.exit(1)


def cmd_contacts(args, base, tok):
    code, d = req(base, "/api/contacts", tok)
    if code != 200:
        sys.exit(f"ERROR {code}: {d}")
    print("Agent 注册表:", ", ".join(d["agents"]))
    if d.get("notice"):
        print(d["notice"])


def cmd_presence(args, base, tok):
    """查看各 agent 在线状态 (online=活跃 SSE 连接, last_seen=最近活跃)"""
    code, d = req(base, "/api/presence", tok)
    if code != 200:
        sys.exit(f"ERROR {code}: {d}")
    for agent in sorted(d):
        p = d[agent]
        icon = "🟢" if p["online"] else "⚪"
        ls = p.get("last_seen") or "-"
        print(f"  {icon} {agent:<12} last_seen: {ls}")


def cmd_health(args, base, tok):
    code, d = req(base, "/api/health", tok)
    if code != 200:
        sys.exit(f"ERROR {code}: {d}")
    print(f"✅ 总线健康: stream={d['stream']} 消息={d['messages']} last_seq={d['last_seq']}")


def cmd_whoami(args, base, tok):
    """验证当前 token 绑定的身份。返回的 slug 应等于你自己的 slug，否则 token 配错了。"""
    code, d = req(base, "/api/whoami", tok)
    if code != 200:
        sys.exit(f"ERROR {code}: {d}")
    print(f"当前 token 身份: {d['agent']}")
    if args.agent and d["agent"] != args.agent:
        sys.exit(f"⚠️ 不匹配! --agent={args.agent} 但 token 实际身份是 {d['agent']} — token 配错了")


def main():
    p = argparse.ArgumentParser(description="a2a — 跨 Agent 消息 CLI")
    p.add_argument("--agent", help="agent slug (从 tokens.env 取 token)")
    p.add_argument("--url", default=os.environ.get("A2A_URL", DEFAULT_URL), help="API base URL")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("inbox", help="拉收件箱")
    sp.add_argument("--unread", action="store_true")
    sp.add_argument("--since", type=int)
    sp.add_argument("--limit", type=int, default=200)
    sp.add_argument("--thread", help="按 thread 过滤 (T9)")
    sp.add_argument("--group", action="store_true", help="按 thread 分组显示 (T9)")
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("send", help="发消息")
    sp.add_argument("to")
    sp.add_argument("subject")
    sp.add_argument("body", nargs="?", default="")
    sp.add_argument("--reply-to", type=int)

    sp = sub.add_parser("reply", help="回复消息并标 replied")
    sp.add_argument("id", type=int)
    sp.add_argument("to", help="收件人 slug")
    sp.add_argument("subject")
    sp.add_argument("body", nargs="?", default="")

    sp = sub.add_parser("status", help="改消息状态")
    sp.add_argument("id", type=int)
    sp.add_argument("status")

    sp = sub.add_parser("mark-read", help="标已读")
    sp.add_argument("id", type=int)

    sp = sub.add_parser("watch", help="SSE 实时监听")
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("meet", help="进入房间交互开会 (T11)")
    sp.add_argument("topic")
    sp.add_argument("--tail", type=int, default=0, help="加入时拉最近 N 条历史")
    sp.add_argument("--leave", action="store_true", help="拉取历史后退出 (非交互)")

    sp = sub.add_parser("ask", help="提问挂起等回复 (T12)")
    sp.add_argument("to")
    sp.add_argument("question", nargs="+", help="问题内容 (可多词)")
    sp.add_argument("--timeout", type=int, default=600, help="超时秒数, 默认 600 (10m)")

    sp = sub.add_parser("contacts", help="Agent 列表")
    sp = sub.add_parser("presence", help="各 agent 在线状态")
    sp = sub.add_parser("health", help="健康检查")
    sp = sub.add_parser("whoami", help="验证当前 token 绑定的身份 (自查 token 是否配错)")

    args = p.parse_args()
    base, tok = resolve_token(args)

    if args.cmd == "inbox":
        cmd_inbox(args, base, tok)
    elif args.cmd == "send":
        cmd_send(args, base, tok)
    elif args.cmd == "reply":
        cmd_reply(args, base, tok)
    elif args.cmd == "status":
        cmd_status(args, base, tok)
    elif args.cmd == "mark-read":
        args.status = "read"
        cmd_status(args, base, tok)
    elif args.cmd == "watch":
        cmd_watch(args, base, tok)
    elif args.cmd == "meet":
        cmd_meet(args, base, tok)
    elif args.cmd == "ask":
        cmd_ask(args, base, tok)
    elif args.cmd == "contacts":
        cmd_contacts(args, base, tok)
    elif args.cmd == "presence":
        cmd_presence(args, base, tok)
    elif args.cmd == "health":
        cmd_health(args, base, tok)
    elif args.cmd == "whoami":
        cmd_whoami(args, base, tok)


if __name__ == "__main__":
    main()
